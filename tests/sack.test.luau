-- The Loot Sack (shared/SackRules): weight, room, value, where loot goes
-- back to, and the summary line.
return function(spec, harness)
	local describe, it, expect = spec.describe, spec.it, spec.expect
	local SackRules = harness.load("SackRules")
	local Crime = harness.load("Config/Crime")

	local ALEX, SAM = 101, 202

	describe("the sack", function()
		it("holds 5 weight: Commons 1, Rares 2, a Legendary fills it", function()
			local sack = SackRules.new()
			expect(SackRules.isEmpty(sack)).toBe(true)
			SackRules.add(sack, "Pumpkin", "Pumpkin||", ALEX)
			SackRules.add(sack, "Carrot", "Carrot||", ALEX)
			expect(SackRules.weight(sack)).toBe(3)
			expect(SackRules.fits(sack, "Pumpkin")).toBe(true)
			SackRules.add(sack, "Pumpkin", "Pumpkin||", ALEX)
			expect(SackRules.weight(sack)).toBe(Crime.SACK_CAPACITY)
			expect(SackRules.fits(sack, "Carrot")).toBe(false)
			expect(SackRules.fits(SackRules.new(), "Moonmelon")).toBe(true)
		end)
		it("knows which farms its loot came from", function()
			local sack = SackRules.new()
			SackRules.add(sack, "Carrot", "Carrot||", ALEX)
			expect(SackRules.hasFrom(sack, ALEX)).toBe(true)
			expect(SackRules.hasFrom(sack, SAM)).toBe(false)
		end)
		it("is worth the loot's market value (base values by default)", function()
			local sack = SackRules.new()
			SackRules.add(sack, "Pumpkin", "Pumpkin||", ALEX)
			SackRules.add(sack, "Carrot", "Carrot||", ALEX)
			expect(SackRules.value(sack.items)).toBe(610 + 18)
			expect(SackRules.value(sack.items, function()
				return 100
			end)).toBe(200)
		end)
		it("empties in one go", function()
			local sack = SackRules.new()
			SackRules.add(sack, "Carrot", "Carrot||", ALEX)
			local items = SackRules.takeAll(sack)
			expect(#items).toBe(1)
			expect(SackRules.isEmpty(sack)).toBe(true)
		end)
		it("slows you to 85% walking", function()
			expect(SackRules.speed(16, true)).toBeNear(13.6, 1e-9)
			expect(SackRules.speed(16, false)).toBe(16)
		end)
		it("sums up its loot for notes and the mugshot", function()
			local sack = SackRules.new()
			SackRules.add(sack, "Pumpkin", "Pumpkin||", ALEX)
			SackRules.add(sack, "Carrot", "Carrot||", ALEX)
			SackRules.add(sack, "Pumpkin", "Pumpkin||", ALEX)
			expect(SackRules.summary(sack.items)).toBe("🎃 Pumpkin ×2, 🥕 Carrot")
		end)
	end)

	describe("returned loot", function()
		local function sackFromBoth()
			local sack = SackRules.new()
			SackRules.add(sack, "Carrot", "Carrot||", ALEX)
			SackRules.add(sack, "Corn", "Corn||", SAM)
			return sack
		end

		it("goes back to each farm's owner when they're here", function()
			local out = SackRules.returns(sackFromBoth().items, function()
				return true
			end, ALEX)
			expect(#out[tostring(ALEX)]).toBe(1)
			expect(#out[tostring(SAM)]).toBe(1)
		end)
		it("goes to the owner who stopped the thief when its own owner has left (§4.12)", function()
			local out = SackRules.returns(sackFromBoth().items, function(id)
				return id == ALEX
			end, ALEX)
			expect(#out[tostring(ALEX)]).toBe(2)
			expect(out[tostring(SAM)]).toBe(nil)
		end)
		it("is lost when nobody stopped them and its owner has left", function()
			local out = SackRules.returns(sackFromBoth().items, function(id)
				return id == ALEX
			end, nil)
			expect(#out[tostring(ALEX)]).toBe(1)
			expect(out[tostring(SAM)]).toBe(nil)
		end)
	end)
end
