-- How crops grow (shared/GrowthRules): online and offline speeds, fresh soil,
-- watering, regrowing crops.
return function(spec, harness)
	local describe, it, expect = spec.describe, spec.it, spec.expect
	local GrowthRules = harness.load("GrowthRules")
	local Growth = harness.load("Config/Growth")

	describe("growing", function()
		it("a Carrot ripens after 60 s online, not before", function()
			local tile = GrowthRules.plant("Carrot")
			GrowthRules.advance(tile, 59)
			expect(GrowthRules.isRipe(tile)).toBe(false)
			GrowthRules.advance(tile, 1)
			expect(GrowthRules.isRipe(tile)).toBe(true)
		end)
		it("offline growth is 25%: a 6 h Mythic takes 24 h away", function()
			local tile = GrowthRules.plant("CrystalRose")
			expect(GrowthRules.secondsLeft(tile, Growth.OFFLINE_RATE)).toBeNear(24 * 3600, 1e-6)
			GrowthRules.offline(tile, 24 * 3600 - 60)
			expect(GrowthRules.isRipe(tile)).toBe(false)
			GrowthRules.offline(tile, 60)
			expect(GrowthRules.isRipe(tile)).toBe(true)
		end)
		it("fresh soil grows the first crop 25% faster, then stops helping", function()
			local tile = GrowthRules.plant("Tomato", true)
			expect(GrowthRules.secondsLeft(tile)).toBeNear(300 / 1.25, 1e-6)
			GrowthRules.advance(tile, 240)
			expect(GrowthRules.isRipe(tile)).toBe(true)
			GrowthRules.harvest(tile)
			expect(tile.fresh).toBe(false)
			expect(GrowthRules.secondsLeft(tile)).toBeNear(240, 1e-6) -- a plain regrow
		end)
		it("weather and boosts speed it up (speed > 1)", function()
			local tile = GrowthRules.plant("Corn")
			GrowthRules.advance(tile, 150, 2)
			expect(GrowthRules.isRipe(tile)).toBe(true)
		end)
		it("stops at ripe", function()
			local tile = GrowthRules.plant("Carrot")
			GrowthRules.advance(tile, 10_000)
			expect(tile.progress).toBe(1)
		end)
	end)

	describe("watering", function()
		it("takes 10% off the time left, once per stage", function()
			local tile = GrowthRules.plant("Pumpkin")
			GrowthRules.advance(tile, 450) -- half way
			expect(GrowthRules.water(tile)).toBe(true)
			expect(tile.progress).toBeNear(0.55, 1e-9)
			expect(GrowthRules.water(tile)).toBe(false)
		end)
		it("does nothing to a ripe crop", function()
			local tile = GrowthRules.plant("Carrot")
			GrowthRules.advance(tile, 60)
			expect(GrowthRules.water(tile)).toBe(false)
		end)
	end)

	describe("harvesting", function()
		it("an unripe crop can't be picked", function()
			local tile = GrowthRules.plant("Carrot")
			local ok, stays = GrowthRules.harvest(tile)
			expect(ok).toBe(false)
			expect(stays).toBe(true)
		end)
		it("a single-harvest crop leaves the tile empty", function()
			local tile = GrowthRules.plant("Carrot")
			GrowthRules.advance(tile, 60)
			local ok, stays = GrowthRules.harvest(tile)
			expect(ok).toBe(true)
			expect(stays).toBe(false)
		end)
		it("a Tomato gives 4 harvests, regrowing every 4 minutes, and can be watered again each time", function()
			local tile = GrowthRules.plant("Tomato")
			GrowthRules.advance(tile, 300)
			local picks = 0
			while true do
				local ok, stays = GrowthRules.harvest(tile)
				expect(ok).toBe(true)
				picks += 1
				if not stays then
					break
				end
				expect(tile.regrowing).toBe(true)
				expect(GrowthRules.water(tile)).toBe(true)
				GrowthRules.advance(tile, 240)
			end
			expect(picks).toBe(4)
			expect(GrowthRules.harvests("Tomato")).toBe(4)
		end)
	end)

	describe("how many a patch gives", function()
		it("is the crop's perPatch at Field Level 1: 6 carrots, 1 pumpkin", function()
			expect(GrowthRules.yieldOf(GrowthRules.plant("Carrot"))).toBe(6)
			expect(GrowthRules.yieldOf(GrowthRules.plant("Pumpkin"))).toBe(1)
			expect(GrowthRules.rollYield("Carrot", 1, 0)).toBe(6)
		end)
		it("rolls the part after the point as the chance of one more", function()
			-- ×1.35 on 6 carrots is 8.1: 8, and 9 one time in ten
			expect(GrowthRules.rollYield("Carrot", 1.35, 0.05)).toBe(9)
			expect(GrowthRules.rollYield("Carrot", 1.35, 0.5)).toBe(8)
			-- ×1.5 on 6 is exactly 9: no roll
			expect(GrowthRules.rollYield("Carrot", 1.5, 0)).toBe(9)
			-- a pumpkin at ×1.35: a second one 35% of the time
			expect(GrowthRules.rollYield("Pumpkin", 1.35, 0.3)).toBe(2)
			expect(GrowthRules.rollYield("Pumpkin", 1.35, 0.4)).toBe(1)
			local total = 0
			local rng = harness.Random.new(11)
			for _ = 1, 4000 do
				total += GrowthRules.rollYield("Pumpkin", 1.35, rng:NextNumber())
			end
			expect(total / 4000).toBeNear(1.35, 0.03)
		end)
		it("is kept by the tile, and a regrowing plant gets its next picking's", function()
			local tile = GrowthRules.plant("Tomato", false, 8)
			expect(GrowthRules.yieldOf(tile)).toBe(8)
			GrowthRules.advance(tile, 300)
			GrowthRules.harvest(tile, 7)
			expect(GrowthRules.yieldOf(tile)).toBe(7)
		end)
		it("goes to a thief whole, but only one pumpkin at a time", function()
			local carrots = GrowthRules.plant("Carrot", false, 8)
			GrowthRules.advance(carrots, 60)
			expect(GrowthRules.carryOf(carrots)).toBe(8)
			expect(GrowthRules.take(carrots, 8)).toBe(false) -- (all of it: the tile's empty)

			local pumpkins = GrowthRules.plant("Pumpkin", false, 2)
			GrowthRules.advance(pumpkins, 900)
			expect(GrowthRules.carryOf(pumpkins)).toBe(1)
			expect(GrowthRules.take(pumpkins, 1)).toBe(true) -- (one stays, still ripe, for the owner)
			expect(GrowthRules.isRipe(pumpkins)).toBe(true)
			expect(GrowthRules.yieldOf(pumpkins)).toBe(1)
			expect(GrowthRules.take(pumpkins, 1)).toBe(false)
		end)
		it("a thief takes a regrowing plant's fruit, not the plant", function()
			local tile = GrowthRules.plant("Strawberry")
			GrowthRules.advance(tile, 240)
			expect(GrowthRules.take(tile, GrowthRules.carryOf(tile), 4)).toBe(true)
			expect(tile.regrowing).toBe(true)
			expect(GrowthRules.isRipe(tile)).toBe(false)
		end)
		it("sets the profit a patch makes at a Field Level", function()
			expect(GrowthRules.patchValue("Carrot")).toBe(180)
			expect(GrowthRules.patchValue("Carrot", 1.5)).toBe(270)
			expect(GrowthRules.profitPerMinute("Carrot", 1.5)).toBeNear(170, 1e-9)
		end)
	end)
end
