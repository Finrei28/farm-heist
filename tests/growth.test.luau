-- How crops grow (shared/GrowthRules): online and offline speeds, fresh soil,
-- watering, regrowing crops.
return function(spec, harness)
	local describe, it, expect = spec.describe, spec.it, spec.expect
	local GrowthRules = harness.load("GrowthRules")
	local Growth = harness.load("Config/Growth")

	describe("growing", function()
		it("a Carrot ripens after 60 s online, not before", function()
			local tile = GrowthRules.plant("Carrot")
			GrowthRules.advance(tile, 59)
			expect(GrowthRules.isRipe(tile)).toBe(false)
			GrowthRules.advance(tile, 1)
			expect(GrowthRules.isRipe(tile)).toBe(true)
		end)
		it("offline growth is 25%: a 6 h Mythic takes 24 h away", function()
			local tile = GrowthRules.plant("CrystalRose")
			expect(GrowthRules.secondsLeft(tile, Growth.OFFLINE_RATE)).toBeNear(24 * 3600, 1e-6)
			GrowthRules.offline(tile, 24 * 3600 - 60)
			expect(GrowthRules.isRipe(tile)).toBe(false)
			GrowthRules.offline(tile, 60)
			expect(GrowthRules.isRipe(tile)).toBe(true)
		end)
		it("fresh soil grows the first crop 25% faster, then stops helping", function()
			local tile = GrowthRules.plant("Tomato", true)
			expect(GrowthRules.secondsLeft(tile)).toBeNear(300 / 1.25, 1e-6)
			GrowthRules.advance(tile, 240)
			expect(GrowthRules.isRipe(tile)).toBe(true)
			GrowthRules.harvest(tile)
			expect(tile.fresh).toBe(false)
			expect(GrowthRules.secondsLeft(tile)).toBeNear(240, 1e-6) -- a plain regrow
		end)
		it("weather and boosts speed it up (speed > 1)", function()
			local tile = GrowthRules.plant("Corn")
			GrowthRules.advance(tile, 150, 2)
			expect(GrowthRules.isRipe(tile)).toBe(true)
		end)
		it("stops at ripe", function()
			local tile = GrowthRules.plant("Carrot")
			GrowthRules.advance(tile, 10_000)
			expect(tile.progress).toBe(1)
		end)
	end)

	describe("watering", function()
		it("takes 10% off the time left, once per stage", function()
			local tile = GrowthRules.plant("Pumpkin")
			GrowthRules.advance(tile, 450) -- half way
			expect(GrowthRules.water(tile)).toBe(true)
			expect(tile.progress).toBeNear(0.55, 1e-9)
			expect(GrowthRules.water(tile)).toBe(false)
		end)
		it("does nothing to a ripe crop", function()
			local tile = GrowthRules.plant("Carrot")
			GrowthRules.advance(tile, 60)
			expect(GrowthRules.water(tile)).toBe(false)
		end)
	end)

	describe("harvesting", function()
		it("an unripe crop can't be picked", function()
			local tile = GrowthRules.plant("Carrot")
			local ok, stays = GrowthRules.harvest(tile)
			expect(ok).toBe(false)
			expect(stays).toBe(true)
		end)
		it("a single-harvest crop leaves the tile empty", function()
			local tile = GrowthRules.plant("Carrot")
			GrowthRules.advance(tile, 60)
			local ok, stays = GrowthRules.harvest(tile)
			expect(ok).toBe(true)
			expect(stays).toBe(false)
		end)
		it("a Tomato gives 4 harvests, regrowing every 4 minutes, and can be watered again each time", function()
			local tile = GrowthRules.plant("Tomato")
			GrowthRules.advance(tile, 300)
			local picks = 0
			while true do
				local ok, stays = GrowthRules.harvest(tile)
				expect(ok).toBe(true)
				picks += 1
				if not stays then
					break
				end
				expect(tile.regrowing).toBe(true)
				expect(GrowthRules.water(tile)).toBe(true)
				GrowthRules.advance(tile, 240)
			end
			expect(picks).toBe(4)
			expect(GrowthRules.harvests("Tomato")).toBe(4)
		end)
	end)
end
