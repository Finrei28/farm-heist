-- Raids (shared/CrimeRules): who may steal, Suspects, bat hits, knockouts,
-- arrests, and every way of dodging an arrest in docs/GameDesign.md §4.12.
return function(spec, harness)
	local describe, it, expect = spec.describe, spec.it, spec.expect
	local Vector3 = require("@lune/roblox").Vector3
	local CrimeRules = harness.load("CrimeRules")
	local Crime = harness.load("Config/Crime")

	local NOW = 1_000_000

	local function stealCtx(overrides)
		local ctx = {
			now = NOW, inside = true, knockedOut = false, thiefProtected = false, farmProtected = false,
			trusted = false, cooldownUntil = 0, ripe = true, rarity = "Rare", sackUsed = 0, raidUsed = 0,
		}
		for k, v in overrides or {} do
			ctx[k] = v
		end
		return ctx
	end

	local function hit(overrides)
		local h = {
			now = NOW, lastSwingAt = NOW - 5, attackerIsOwner = true, attackerInside = true, targetInside = true,
			distance = 5, angle = 10, lineClear = true, targetTrusted = false, targetImmune = false,
		}
		for k, v in overrides or {} do
			h[k] = v
		end
		return h
	end

	local function reason(ok, why)
		return if ok then "ok" else why
	end

	describe("who may steal", function()
		it("a ripe crop in someone else's farm, with room in the sack", function()
			expect(reason(CrimeRules.canSteal(stealCtx()))).toBe("ok")
		end)
		it("nobody under a Sprout Shield or arrival grace, either way round", function()
			expect(reason(CrimeRules.canSteal(stealCtx({ thiefProtected = true })))).toBe("YouAreProtected")
			expect(reason(CrimeRules.canSteal(stealCtx({ farmProtected = true })))).toBe("FarmProtected")
		end)
		it("not Trusted friends, not during the same-farm cooldown, not unripe crops, not knocked out", function()
			expect(reason(CrimeRules.canSteal(stealCtx({ trusted = true })))).toBe("Trusted")
			expect(reason(CrimeRules.canSteal(stealCtx({ cooldownUntil = NOW + 10 })))).toBe("Cooldown")
			expect(reason(CrimeRules.canSteal(stealCtx({ ripe = false })))).toBe("NotRipe")
			expect(reason(CrimeRules.canSteal(stealCtx({ knockedOut = true })))).toBe("KnockedOut")
			expect(reason(CrimeRules.canSteal(stealCtx({ inside = false })))).toBe("NotInside")
		end)
		it("a sack holds 5 weight: two Rares, then no third", function()
			expect(reason(CrimeRules.canSteal(stealCtx({ sackUsed = 2 })))).toBe("ok")
			expect(reason(CrimeRules.canSteal(stealCtx({ sackUsed = 4 })))).toBe("SackFull")
			expect(reason(CrimeRules.canSteal(stealCtx({ rarity = "Mythic", sackUsed = 1 })))).toBe("SackFull")
		end)
		it("a farm loses at most 10 weight per 10 minutes", function()
			local ledger = {}
			CrimeRules.raidAdd(ledger, NOW, 5)
			CrimeRules.raidAdd(ledger, NOW + 60, 4)
			local used = CrimeRules.raidUsed(ledger, NOW + 120)
			expect(used).toBe(9)
			expect(reason(CrimeRules.canSteal(stealCtx({ raidUsed = used })))).toBe("RaidCap")
			expect(reason(CrimeRules.canSteal(stealCtx({ raidUsed = used, rarity = "Common" })))).toBe("ok")
			expect(CrimeRules.raidUsed(ledger, NOW + Crime.RAID_WINDOW + 1)).toBe(4)
		end)
		it("loot that goes back to the farm doesn't count against the cap", function()
			local ledger = {}
			local entry = CrimeRules.raidAdd(ledger, NOW, 5)
			CrimeRules.raidAdd(ledger, NOW + 1, 2)
			CrimeRules.raidRemove(ledger, entry)
			expect(CrimeRules.raidUsed(ledger, NOW + 2)).toBe(2)
		end)
	end)

	describe("steal holds", function()
		it("take the rarity's time, twice under a cloche, a quarter less on a Harvest Moon", function()
			expect(CrimeRules.stealHold("Rare")).toBe(2.5)
			expect(CrimeRules.stealHold("Rare", { cloche = true })).toBe(5)
			expect(CrimeRules.stealHold("Rare", { harvestMoon = true })).toBe(1.875)
			expect(CrimeRules.stealHold("Mythic")).toBe(7)
		end)
		it("finish only once the full time has passed (the server times it)", function()
			expect(CrimeRules.holdDone(NOW, NOW + 2, 2.5)).toBe(false)
			expect(CrimeRules.holdDone(NOW, NOW + 2.5, 2.5)).toBe(true)
		end)
	end)

	describe("Suspects", function()
		it("starting a steal makes you one, for the whole visit", function()
			local visit = CrimeRules.newVisit()
			CrimeRules.enter(visit, NOW)
			expect(CrimeRules.isSuspect(visit, NOW)).toBe(false)
			CrimeRules.markSuspect(visit, NOW)
			expect(CrimeRules.isSuspect(visit, NOW + 600)).toBe(true) -- still inside
		end)
		it("popping out and back within 60 s doesn't clear it; staying away longer does", function()
			local visit = CrimeRules.newVisit()
			CrimeRules.enter(visit, NOW)
			CrimeRules.markSuspect(visit, NOW)
			CrimeRules.exit(visit)
			CrimeRules.enter(visit, NOW + 30)
			expect(CrimeRules.isSuspect(visit, NOW + 400)).toBe(true)
			CrimeRules.exit(visit)
			expect(CrimeRules.isSuspect(visit, NOW + 461)).toBe(false)
			CrimeRules.enter(visit, NOW + 500)
			expect(CrimeRules.isSuspect(visit, NOW + 500)).toBe(false)
		end)
		it("carrying a sack inside a farm makes you one there, even with loot from another farm", function()
			local visit = CrimeRules.newVisit()
			CrimeRules.enter(visit, NOW)
			expect(CrimeRules.isSuspect(visit, NOW, true)).toBe(true)
		end)
	end)

	describe("the bat", function()
		it("hits within 7 studs (+1 for lag), in front, with a clear line", function()
			expect(reason(CrimeRules.validHit(hit()))).toBe("ok")
			expect(reason(CrimeRules.validHit(hit({ distance = 7.9 })))).toBe("ok")
			expect(reason(CrimeRules.validHit(hit({ distance = 8.1 })))).toBe("TooFar")
			expect(reason(CrimeRules.validHit(hit({ angle = 60 })))).toBe("Behind")
			expect(reason(CrimeRules.validHit(hit({ lineClear = false })))).toBe("Blocked")
		end)
		it("only works for the owner, inside their own farm, on someone inside it", function()
			expect(reason(CrimeRules.validHit(hit({ attackerIsOwner = false })))).toBe("NotOwner")
			expect(reason(CrimeRules.validHit(hit({ attackerInside = false })))).toBe("OwnerOutside")
			expect(reason(CrimeRules.validHit(hit({ targetInside = false })))).toBe("TargetOutside")
		end)
		it("never hits Trusted friends or someone immune, and swings every 0.8 s at most", function()
			expect(reason(CrimeRules.validHit(hit({ targetTrusted = true })))).toBe("Trusted")
			expect(reason(CrimeRules.validHit(hit({ targetImmune = true })))).toBe("Immune")
			expect(reason(CrimeRules.validHit(hit({ lastSwingAt = NOW - 0.5 })))).toBe("Cooldown")
		end)
		it("reaches round you when someone is right up against you", function()
			expect(reason(CrimeRules.validHit(hit({ distance = 2, angle = 150 })))).toBe("ok")
			expect(reason(CrimeRules.validHit(hit({ distance = 4, angle = 150 })))).toBe("Behind")
		end)
		it("measures the angle on the ground", function()
			local from = Vector3.new(0, 0, 0)
			local facing = Vector3.new(1, 0, 0)
			expect(CrimeRules.angleTo(facing, from, Vector3.new(5, 3, 0))).toBeNear(0, 1e-6)
			expect(CrimeRules.angleTo(facing, from, Vector3.new(0, 0, 5))).toBeNear(90, 1e-6)
			expect(CrimeRules.angleTo(facing, from, Vector3.new(-5, 0, 0))).toBeNear(180, 1e-6)
		end)
	end)

	describe("knockouts and arrests", function()
		it("anyone hit is knocked out for 5 s, then immune for 6 s (no stun-lock)", function()
			local visit = CrimeRules.newVisit()
			CrimeRules.enter(visit, NOW)
			CrimeRules.knockOut(visit, NOW)
			expect(CrimeRules.isKnockedOut(visit, NOW + 4.9)).toBe(true)
			expect(CrimeRules.isKnockedOut(visit, NOW + 5)).toBe(false)
			expect(CrimeRules.isImmune(visit, NOW + 10.9)).toBe(true)
			expect(CrimeRules.isImmune(visit, NOW + 11)).toBe(false)
		end)
		it("an innocent visitor can't be arrested and gets the Leave farm button", function()
			local visit = CrimeRules.newVisit()
			CrimeRules.enter(visit, NOW)
			expect(CrimeRules.knockOut(visit, NOW)).toBe(false)
			expect(reason(CrimeRules.canArrest(visit, NOW + 1, { distance = 3, ownerInside = true }))).toBe("NotSuspect")
			expect(CrimeRules.canLeaveFarm(visit, NOW + 1)).toBe(true)
		end)
		it("a knocked-out Suspect can be arrested within 8 studs, while the owner is inside, for 5 s", function()
			local visit = CrimeRules.newVisit()
			CrimeRules.enter(visit, NOW)
			CrimeRules.markSuspect(visit, NOW)
			expect(CrimeRules.knockOut(visit, NOW + 2)).toBe(true)
			expect(reason(CrimeRules.canArrest(visit, NOW + 3, { distance = 8, ownerInside = true }))).toBe("ok")
			expect(reason(CrimeRules.canArrest(visit, NOW + 3, { distance = 9, ownerInside = true }))).toBe("TooFar")
			expect(reason(CrimeRules.canArrest(visit, NOW + 3, { distance = 3, ownerInside = false }))).toBe("OwnerOutside")
			expect(reason(CrimeRules.canArrest(visit, NOW + 7, { distance = 3, ownerInside = true }))).toBe("NotKnockedOut")
			expect(CrimeRules.canLeaveFarm(visit, NOW + 3)).toBe(false)
		end)
		it("someone caught carrying loot from another farm stays arrestable after the sack goes back", function()
			local visit = CrimeRules.newVisit()
			CrimeRules.enter(visit, NOW)
			expect(CrimeRules.knockOut(visit, NOW, true)).toBe(true)
			expect(reason(CrimeRules.canArrest(visit, NOW + 1, { distance = 3, ownerInside = true }))).toBe("ok")
		end)
	end)

	describe("dodging an arrest", function()
		local function suspectKnockedOut()
			local visit = CrimeRules.newVisit()
			CrimeRules.enter(visit, NOW)
			CrimeRules.markSuspect(visit, NOW)
			CrimeRules.knockOut(visit, NOW)
			return visit
		end

		it("quitting while knocked out as a Suspect is an automatic arrest (Fled)", function()
			expect(CrimeRules.leaveOutcome(suspectKnockedOut(), NOW + 2, { carrying = false })).toBe("Fled")
		end)
		it("quitting while knocked out but innocent does nothing", function()
			local visit = CrimeRules.newVisit()
			CrimeRules.enter(visit, NOW)
			CrimeRules.knockOut(visit, NOW)
			expect(CrimeRules.leaveOutcome(visit, NOW + 2, { carrying = false })).toBe("None")
		end)
		it("quitting with loot while the owner is close, or swung lately, counts as fleeing (Chased)", function()
			local visit = CrimeRules.newVisit()
			CrimeRules.enter(visit, NOW)
			CrimeRules.markSuspect(visit, NOW)
			expect(CrimeRules.leaveOutcome(visit, NOW + 5, { carrying = true, ownerDistance = 20 })).toBe("Chased")
			CrimeRules.swungAt(visit, NOW + 6)
			expect(CrimeRules.leaveOutcome(visit, NOW + 12, { carrying = true, ownerDistance = 80 })).toBe("Chased")
		end)
		it("quitting with loot when nobody is chasing just sends the loot back (could be a disconnect)", function()
			local visit = CrimeRules.newVisit()
			CrimeRules.enter(visit, NOW)
			CrimeRules.markSuspect(visit, NOW)
			expect(CrimeRules.leaveOutcome(visit, NOW + 5, { carrying = true, ownerDistance = 80 })).toBe("ReturnLoot")
			expect(CrimeRules.leaveOutcome(visit, NOW + 5, { carrying = true, ownerDistance = nil })).toBe("ReturnLoot")
		end)
		it("a server shutting down never penalises anyone", function()
			expect(CrimeRules.leaveOutcome(suspectKnockedOut(), NOW + 2, { carrying = true, shuttingDown = true })).toBe("ReturnLoot")
			expect(CrimeRules.leaveOutcome(suspectKnockedOut(), NOW + 2, { carrying = false, shuttingDown = true })).toBe("None")
		end)
		it("the reset button is off while a Suspect, knocked out or carrying", function()
			local visit = CrimeRules.newVisit()
			CrimeRules.enter(visit, NOW)
			expect(CrimeRules.canReset(visit, NOW)).toBe(true)
			expect(CrimeRules.canReset(visit, NOW, true)).toBe(false)
			CrimeRules.markSuspect(visit, NOW)
			expect(CrimeRules.canReset(visit, NOW)).toBe(false)
		end)
		it("dying or being removed while knocked out as a Suspect is an automatic arrest", function()
			expect(CrimeRules.deathOutcome(suspectKnockedOut(), NOW + 1)).toBe("Fled")
			local visit = CrimeRules.newVisit()
			expect(CrimeRules.deathOutcome(visit, NOW)).toBe("None")
		end)
		it("rejoining within 2 minutes of an arrest starts on the police porch", function()
			local crime = { lastArrestAt = NOW }
			expect(CrimeRules.startsOnPorch(crime, NOW + 60)).toBe(true)
			expect(CrimeRules.startsOnPorch(crime, NOW + Crime.POLICE_PORCH_REJOIN)).toBe(false)
			expect(CrimeRules.startsOnPorch({ lastArrestAt = 0 }, NOW)).toBe(false)
		end)
		it("staged arrests between friends don't count for the Sheriff board", function()
			expect(CrimeRules.countsForBoard(40, 0)).toBe(false)
			expect(CrimeRules.countsForBoard(610, 2)).toBe(true)
			expect(CrimeRules.countsForBoard(610, 3)).toBe(false)
		end)
	end)
end
