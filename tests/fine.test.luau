-- Fines and debt (shared/FineRules): the formula, the repeat multiplier,
-- fleeing, debt collected from income, and no coins created from nothing.
return function(spec, harness)
	local describe, it, expect = spec.describe, spec.it, spec.expect

	describe("paying at the police desk", function()
		local FineRules = harness.load("FineRules")
		it("pays what's asked, up to the debt and the purse", function()
			expect(FineRules.payAmount("all", 500, 900)).toBe(500)
			expect(FineRules.payAmount("all", 500, 200)).toBe(200)
			expect(FineRules.payAmount("120.7", 500, 900)).toBe(120)
			expect(FineRules.payAmount("9999", 500, 900)).toBe(500)
		end)
		it("anything that isn't a real amount pays nothing", function()
			for _, arg in { "nan", "NaN", "-nan", "-5", "-inf", "junk", "" } do
				expect(FineRules.payAmount(arg, 500, 900)).toBe(0)
			end
			expect(FineRules.payAmount(nil, 500, 900)).toBe(0)
		end)
		it("infinity is only as much as the debt", function()
			expect(FineRules.payAmount("inf", 500, 900)).toBe(500)
		end)
		it("a purse below zero pays nothing", function()
			expect(FineRules.payAmount("all", 500, -40)).toBe(0)
		end)
	end)
	local FineRules = harness.load("FineRules")
	local Crime = harness.load("Config/Crime")

	local NOW = 1_000_000

	local function thief(coins)
		return { coins = coins, crime = { earn = {}, arrests = {}, debts = {}, lastArrestAt = 0 } }
	end

	describe("the fine", function()
		it("is at least 250, and at least 1.5× the loot", function()
			expect(FineRules.amount({ lootValue = 0, earnings = 0 })).toBe(250)
			expect(FineRules.amount({ lootValue = 610, earnings = 0 })).toBe(915)
		end)
		it("is 8% of the last hour's earnings when that's more (the BUSTED card: 960)", function()
			expect(FineRules.amount({ lootValue = 610, earnings = 12_000 })).toBe(960)
		end)
		it("grows for repeat offenders: ×1, ×1.5, ×2, ×2", function()
			expect(FineRules.amount({ lootValue = 1000, prior = 0 })).toBe(1500)
			expect(FineRules.amount({ lootValue = 1000, prior = 1 })).toBe(2250)
			expect(FineRules.amount({ lootValue = 1000, prior = 2 })).toBe(3000)
			expect(FineRules.amount({ lootValue = 1000, prior = 5 })).toBe(3000)
		end)
		it("is ×1.5 for fleeing", function()
			expect(FineRules.amount({ lootValue = 1000, fled = true })).toBe(2250)
		end)
		it("makes a defended raid break even at a 40% arrest rate (the 1.5× floor)", function()
			local loot = 1000
			local expected = 0.6 * loot - 0.4 * Crime.FLOOR_LOOT * loot
			expect(expected).toBeNear(0, 1e-9)
		end)
	end)

	describe("earnings", function()
		it("count the last hour of sales, in 5-minute buckets", function()
			local crime = thief(0).crime
			FineRules.addEarnings(crime, NOW, 1000)
			FineRules.addEarnings(crime, NOW + 1800, 500)
			expect(FineRules.lastHour(crime, NOW + 1800)).toBe(1500)
			expect(FineRules.lastHour(crime, NOW + 3600)).toBe(500)
			FineRules.addEarnings(crime, NOW + 7200, 1)
			local buckets = 0
			for _ in crime.earn do
				buckets += 1
			end
			expect(buckets).toBe(1) -- old buckets are dropped
		end)
	end)

	describe("arresting", function()
		it("takes the fine from the wallet; the owner gets exactly that", function()
			local data = thief(5000)
			local result = FineRules.arrest(data, 42, 610, NOW)
			expect(result.fine).toBe(915)
			expect(result.paid).toBe(915)
			expect(result.owed).toBe(0)
			expect(data.coins).toBe(5000 - 915)
		end)
		it("turns what's missing into debt (spending everything first doesn't dodge it)", function()
			local data = thief(100)
			local result = FineRules.arrest(data, 42, 610, NOW)
			expect(result.paid).toBe(100)
			expect(result.owed).toBe(815)
			expect(data.coins).toBe(0)
			expect(FineRules.totalDebt(data.crime, NOW)).toBe(815)
			expect(FineRules.inDebt(data.crime, NOW)).toBe(true)
		end)
		it("pays nothing now from an empty alt account (fines never create coins)", function()
			local result = FineRules.arrest(thief(0), 42, 20, NOW)
			expect(result.paid).toBe(0)
			expect(result.owed).toBe(result.fine)
		end)
		it("counts earlier arrests in the last 30 minutes", function()
			local data = thief(1e6)
			expect(FineRules.arrest(data, 1, 1000, NOW).fine).toBe(1500)
			expect(FineRules.arrest(data, 2, 1000, NOW + 60).fine).toBe(2250)
			expect(FineRules.arrest(data, 3, 1000, NOW + 120).fine).toBe(3000)
			expect(FineRules.arrest(data, 4, 1000, NOW + 120 + Crime.REPEAT_WINDOW).fine).toBe(1500)
		end)
		it("remembers that they fled (the next join starts on the police porch)", function()
			local data = thief(1e6)
			FineRules.arrest(data, 1, 100, NOW, true)
			expect(data.crime.fled).toBe(true)
			expect(data.crime.lastArrestAt).toBe(NOW)
		end)
	end)

	describe("debt", function()
		it("takes half of new income, oldest debt first, and says who to pay", function()
			local data = thief(0)
			FineRules.arrest(data, 11, 200, NOW) -- 300 owed to 11
			FineRules.arrest(data, 22, 200, NOW + 10) -- 450 owed to 22 (second arrest: ×1.5)
			local kept, payments = FineRules.garnish(data.crime, 1000, NOW + 20)
			expect(kept).toBe(500)
			expect(payments["11"]).toBe(300)
			expect(payments["22"]).toBe(200)
			expect(FineRules.totalDebt(data.crime, NOW + 20)).toBe(250)
		end)
		it("keeps the rest of the half when the debt is smaller", function()
			local data = thief(0)
			FineRules.arrest(data, 11, 0, NOW) -- 250 owed
			local kept, payments = FineRules.garnish(data.crime, 1000, NOW)
			expect(kept).toBe(750)
			expect(payments["11"]).toBe(250)
			expect(FineRules.inDebt(data.crime, NOW)).toBe(false)
		end)
		it("leaves income alone with no debt", function()
			local kept, payments = FineRules.garnish(thief(0).crime, 1000, NOW)
			expect(kept).toBe(1000)
			expect(next(payments)).toBe(nil)
		end)
		it("can be paid early at the police desk", function()
			local data = thief(0)
			FineRules.arrest(data, 11, 200, NOW)
			local change, payments = FineRules.payEarly(data.crime, 500, NOW)
			expect(change).toBe(200)
			expect(payments["11"]).toBe(300)
		end)
		it("is forgiven after 7 days", function()
			local data = thief(0)
			FineRules.arrest(data, 11, 200, NOW)
			expect(FineRules.inDebt(data.crime, NOW + Crime.DEBT_EXPIRY - 1)).toBe(true)
			expect(FineRules.inDebt(data.crime, NOW + Crime.DEBT_EXPIRY)).toBe(false)
		end)
	end)
end
