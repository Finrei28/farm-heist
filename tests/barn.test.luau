-- The Barn inventory (shared/BarnRules): stack keys, capacity by Silo, seeds.
return function(spec, harness)
	local describe, it, expect = spec.describe, spec.it, spec.expect
	local BarnRules = harness.load("BarnRules")
	local Barn = harness.load("Config/Barn")

	local function newInventory()
		return { crops = {}, seeds = { Carrot = 2 }, items = {} }
	end

	describe("stack keys", function()
		it("round-trips crop, mutation and Giant", function()
			expect(BarnRules.key("Carrot")).toBe("Carrot||")
			expect(BarnRules.key("Pumpkin", "Wet", true)).toBe("Pumpkin|Wet|G")
			local cropId, mutation, giant = BarnRules.parse("Pumpkin|Wet|G")
			expect(cropId).toBe("Pumpkin")
			expect(mutation).toBe("Wet")
			expect(giant).toBe(true)
			cropId, mutation, giant = BarnRules.parse(BarnRules.key("Carrot"))
			expect(cropId).toBe("Carrot")
			expect(mutation).toBe(nil)
			expect(giant).toBe(false)
		end)
	end)

	describe("capacity", function()
		it("holds 1,200 crops at the start (about 200 patches' worth), more with each Silo", function()
			expect(BarnRules.capacity(0)).toBe(1_200)
			expect(BarnRules.capacity(nil)).toBe(1_200)
			expect(BarnRules.capacity(3)).toBe(30_000)
			expect(BarnRules.capacity(9)).toBe(30_000) -- (no more than the last Silo)
			expect(#Barn.SILO_COST).toBe(3)
		end)
		it("counts every stack towards it", function()
			local inventory = newInventory()
			BarnRules.addCrops(inventory, BarnRules.key("Carrot"), 1_150)
			BarnRules.addCrops(inventory, BarnRules.key("Carrot", "Wet"), 44)
			expect(BarnRules.units(inventory)).toBe(1_194)
			expect(BarnRules.hasRoom({ inventory = inventory, silo = 0 }, 6)).toBe(true) -- (a patch of carrots fits)
			expect(BarnRules.hasRoom({ inventory = inventory, silo = 0 }, 7)).toBe(false) -- (a bigger one doesn't)
			BarnRules.addCrops(inventory, BarnRules.key("Corn"), 6)
			expect(BarnRules.hasRoom({ inventory = inventory, silo = 0 })).toBe(false)
			expect(BarnRules.hasRoom({ inventory = inventory, silo = 1 }, 6)).toBe(true)
		end)
		it("holds 2.5× as many with the Bigger Barn pass", function()
			expect(BarnRules.capacity(0, true)).toBe(3_000)
			expect(BarnRules.capacity(3, true)).toBe(75_000)
			local inventory = newInventory()
			BarnRules.addCrops(inventory, BarnRules.key("Carrot"), 1_200)
			expect(BarnRules.hasRoom({ inventory = inventory, silo = 0, passes = {} }, 6)).toBe(false)
			expect(BarnRules.hasRoom({ inventory = inventory, silo = 0, passes = { BiggerBarn = true } }, 6)).toBe(true)
			expect(BarnRules.capacityOf({ silo = 2, passes = { BiggerBarn = true } })).toBe(22_500)
			expect(BarnRules.capacityOf({ silo = 2 })).toBe(9_000)
		end)
		it("lets deposits go past it (callers skip the check)", function()
			local inventory = newInventory()
			BarnRules.addCrops(inventory, BarnRules.key("Carrot"), 1_260)
			expect(BarnRules.units(inventory)).toBe(1_260)
			expect(BarnRules.hasRoom({ inventory = inventory, silo = 0 })).toBe(false)
		end)
	end)

	describe("taking", function()
		it("takes crops only when there are enough, and drops empty stacks", function()
			local inventory = newInventory()
			local key = BarnRules.key("Carrot")
			BarnRules.addCrops(inventory, key, 3)
			expect(BarnRules.takeCrops(inventory, key, 4)).toBe(false)
			expect(BarnRules.takeCrops(inventory, key, 0)).toBe(false)
			expect(BarnRules.takeCrops(inventory, key, 3)).toBe(true)
			expect(inventory.crops[key]).toBe(nil)
		end)
		it("uses seeds one at a time, and drops the entry at zero", function()
			local inventory = newInventory()
			expect(BarnRules.takeSeed(inventory, "Carrot")).toBe(true)
			expect(BarnRules.takeSeed(inventory, "Carrot")).toBe(true)
			expect(inventory.seeds.Carrot).toBe(nil)
			expect(BarnRules.takeSeed(inventory, "Carrot")).toBe(false)
			BarnRules.addSeeds(inventory, "Corn", 5)
			expect(inventory.seeds.Corn).toBe(5)
		end)
	end)
end
